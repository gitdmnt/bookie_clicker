# フロントエンド環境変数テンプレート
# このファイルをコピーして .env.local (開発用) または .env.production (本番用) を作成すること
# .env.local と .env.production は .gitignore に追加すること

# Cloudflare Workers バックエンドのベースURL
# 開発時: http://localhost:8787
# 本番時: https://<worker-name>.<subdomain>.workers.dev
VITE_API_BASE_URL=https://REPLACE_WITH_YOUR_WORKER_URL

# Google OAuth クライアントID (https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
